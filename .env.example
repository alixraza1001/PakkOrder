PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security — generate strong local values; never commit real secrets
JWT_SECRET=
ADMIN_SECRET=

# Meta Cloud API (WhatsApp)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_WHATSAPP_NUMBER=
META_TEMPLATE_NAME=order_confirmation

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Alternative for hosted environments: single-line JSON service account value
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=

# Email
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=PakkOrder
CONTACT_NOTIFY_EMAIL=

# Shopify OAuth App
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WhatsApp queue limits
WA_DAILY_LIMIT=1000
WA_HOURLY_LIMIT=250

# Optional / legacy integration
ROBOCALL_API_KEY=
